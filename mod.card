return {
  summary = "Eighteen permanent per-Pokemon ribbons for Gen1 achievements, awarded automatically and shown on the Pokemon's own status screen.",
  author  = "mistermiracle3036",

  tags = { "mechanic", "collection", "ui" },

  differences = {
    changed = {
      "the status screen gains a third page: A cycles STATS -> MOVES -> RIBBONS -> close, so no menu anywhere gains a row for it",
      "the START menu gains a RIBBONS row before SAVE, for a whole-party overview",
    },
    added = {
      "Pokemon now carry ribbons (mon.ribbons), stored on the mon itself so they persist through boxes, evolution and trades",
      "Starter Ribbon: awarded to the Pokemon you chose in Oak's lab (or Yellow's lab Pikachu)",
      "retroactive sync -- an existing save gets the Starter Ribbon on the correct Pokemon at load, with no player intervention",
      "Cool Ribbon: awarded to the Pokemon that wins the COOL Contest in the Kanto Contests mod (v0.7.3+), read back from the win recorded on the mon itself so it applies retroactively and outlives that mod being removed; contest ribbons are one per category, the rest arrive as that mod adds those contests",
    },
    known = {
      "a starter that was released or traded away cannot be tagged -- there is no Pokemon left to tag; logged rather than guessed at",
      "a Yellow save holding both the lab Pikachu and a wild-caught one is genuinely ambiguous (Gen1 stores nothing to separate them); resolved party-before-boxes with a warning in the log",
      "icon colour is not the mod's to choose: the screen exposes no sgbPalettes(), so PaletteFX colours each icon by its tile position and the same ribbon can look different colours at different scroll positions -- icons are distinguished by silhouette, not hue",
      "win streaks (Winning, Victory), Legend, Earth, Warrior and pre-0.7.4 snags cannot apply retroactively -- the save records nothing to recompute them from, so they are awarded live only and a run predating the mod earns them from zero",
    },
  },

  credits = {
    { who = "Kanto Achievements", for_ = "the optional stat/counter exports later ribbons will read instead of re-tracking, and the catalog-plus-resolver shape this mod follows" },
    { who = "DexNav example", for_ = "the screens registry + ui hook decoration pattern used for both ribbon screens" },
    { who = "G1R HoldToScrollUI (WizzStar)", for_ = "the hold-to-scroll interaction design behind the 0.12.0 ribbons screen -- not a dependency, but compatible for free since this screen polls plain directional input" },
    { who = "Miss Default Bunny", for_ = "suggesting the Shiny Ribbon, in the gen1recomp Discord" },
    { who = "Kanto Contests", for_ = "recording a contest win on the Pokemon itself, per category, which is what the contest ribbons read" },
  },

  -- keep this in step with manifest.json's game_version
  compat = { engine = ">=0.1.38 <2.0.0", modApi = 2 },
}
